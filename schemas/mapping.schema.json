{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/speckit-openproject/mapping.schema.json",
  "title": "spec-kit OpenProject mapping ledger",
  "type": "object",
  "required": ["schema_version", "project", "feature", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project": {"type": "string"},
    "feature": {"type": "string", "description": "feature directory name, e.g. 001-tasks-to-work-packages"},
    "items": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "id"],
        "properties": {
          "kind": {"enum": ["feature", "phase", "task"]},
          "id": {"type": "integer", "minimum": 1},
          "url": {"type": "string", "description": "path only, no host"},
          "hash": {"type": "string", "description": "content hash of the source item at last sync"},
          "status": {"type": "string", "description": "last synced status"},
          "assignee": {"type": "string", "minLength": 1, "description": "display name at last sync; never a URL, host or token"}
        },
        "additionalProperties": false
      }
    },
    "documents": {
      "type": "object",
      "description": "design documents synced to the feature work package by speckit.openproject.sync-docs; key = file name",
      "propertyNames": {"enum": ["spec.md", "plan.md", "research.md", "data-model.md"]},
      "additionalProperties": {
        "type": "object",
        "required": ["hash", "attachment_id", "synced"],
        "properties": {
          "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the file bytes last uploaded"},
          "attachment_id": {"type": "integer", "minimum": 1, "description": "attachment holding that content"},
          "synced": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "date of the run that uploaded that content"},
          "pending_delete": {"type": "integer", "minimum": 1, "description": "superseded attachment id that is still to be deleted"}
        },
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "properties": {
          "from": {"type": "string", "description": "successor item key"},
          "to": {"type": "string", "description": "predecessor item key"},
          "type": {"enum": ["follows"]},
          "id": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "version": {
      "type": "object",
      "description": "the OpenProject version the feature was mapped to by speckit.openproject.sync-version",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "time_entries": {
      "type": "array",
      "description": "time entries logged by speckit.openproject.log-time; never edited or deleted by this project",
      "items": {
        "type": "object",
        "required": ["key", "work_package_id", "spent_on", "activity", "hours", "id"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "work_package_id": {"type": "integer", "minimum": 1},
          "spent_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "activity": {"type": "string", "minLength": 1},
          "hours": {"type": "string", "pattern": "^PT(\\d+H)?(\\d+M)?$"},
          "id": {"type": "integer", "minimum": 1},
          "entry_key": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
