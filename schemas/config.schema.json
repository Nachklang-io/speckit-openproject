{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/speckit-openproject/config.schema.json",
  "title": "spec-kit OpenProject integration config",
  "type": "object",
  "required": ["project", "types"],
  "properties": {
    "project": {"type": "string", "description": "OpenProject project identifier or id; empty means ask"},
    "mcp_server": {"type": "string"},
    "types": {
      "type": "object",
      "required": ["feature", "phase", "task"],
      "properties": {
        "feature": {"type": "string", "minLength": 1},
        "phase": {"type": "string", "minLength": 1},
        "task": {"type": "string", "minLength": 1},
        "subtask": {"type": "string"}
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "properties": {
        "status": {"type": "string"},
        "priority": {"type": "string"},
        "assignee": {"type": "string"},
        "version": {"type": "string", "$comment": "ignored by speckit.taskstoissues"}
      },
      "additionalProperties": false
    },
    "statuses": {
      "type": "object",
      "properties": {
        "open": {"type": "string", "minLength": 1},
        "in_progress": {"type": "string", "minLength": 1},
        "done": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false,
      "$comment": "optional; written by speckit.openproject.discover-fields, read by status sync, ignored by speckit.taskstoissues"
    },
    "create_relations": {"type": "boolean"},
    "mark_parallel": {"type": "boolean"},
    "required_custom_fields": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}}
  },
  "additionalProperties": false
}
