# Copy to .env (git-ignored) or export in your shell. Used by .mcp.json via ${VAR} expansion.
# Use a TEST instance and a dedicated user with a least-privilege token. Never commit real values.
OPENPROJECT_BASE_URL=https://openproject.example.com
OPENPROJECT_API_TOKEN=
# Comma-separated project identifiers the MCP server may read / write (allowlists)
OPENPROJECT_READ_PROJECTS=speckit-sandbox
OPENPROJECT_WRITE_PROJECTS=speckit-sandbox
